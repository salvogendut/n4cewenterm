10 REM N4CWENTERM - Net4CPC Terminal
20 REM Based on M4EWENTERM by F Leen
30 REM Adapted for Net4CPC
40 MODE 2
50 PRINT "Loading N4C-EWEN Terminal..."
60 PRINT
70 REM
80 REM
90 REM
100 REM Load character set
110 MEMORY &6800-1
120 LOAD "charset.bin",&6800
130 REM Check W5100S chip (do NOT reset - would lose NCFG settings!)
135 PRINT "Checking Net4CPC W5100S..."
140 REM Enable indirect bus mode + auto-increment (required for multi-byte I/O)
141 OUT &FD20,3:REM Set MR = 3 (auto-increment + indirect bus mode)
145 A=INP(&FD20)
146 PRINT "W5100S Mode Register = ";A
147 IF A=3 THEN PRINT "W5100S ready" ELSE PRINT "WARNING: Mode not set correctly!"
148 PRINT "Press any key to continue..."
149 CALL &BB18:REM Wait for keypress
150 REM Configure W5100S network settings
160 PRINT
161 PRINT "Configuring W5100S network..."
162 REM Write MAC address (DE:AD:BE:EF:00:FF)
163 OUT &FD21,0:OUT &FD22,9:OUT &FD23,&DE
164 OUT &FD21,0:OUT &FD22,&A:OUT &FD23,&AD
165 OUT &FD21,0:OUT &FD22,&B:OUT &FD23,&BE
166 OUT &FD21,0:OUT &FD22,&C:OUT &FD23,&EF
167 OUT &FD21,0:OUT &FD22,&D:OUT &FD23,0
168 OUT &FD21,0:OUT &FD22,&E:OUT &FD23,&FF
169 REM Write IP: 192.168.68.254
170 OUT &FD21,0:OUT &FD22,&F:OUT &FD23,192
171 OUT &FD21,0:OUT &FD22,&10:OUT &FD23,168
172 OUT &FD21,0:OUT &FD22,&11:OUT &FD23,68
173 OUT &FD21,0:OUT &FD22,&12:OUT &FD23,254
174 REM Write Subnet: 255.255.255.0
175 OUT &FD21,0:OUT &FD22,5:OUT &FD23,255
176 OUT &FD21,0:OUT &FD22,6:OUT &FD23,255
177 OUT &FD21,0:OUT &FD22,7:OUT &FD23,255
178 OUT &FD21,0:OUT &FD22,8:OUT &FD23,0
179 REM Write Gateway: 192.168.68.1
180 OUT &FD21,0:OUT &FD22,1:OUT &FD23,192
181 OUT &FD21,0:OUT &FD22,2:OUT &FD23,168
182 OUT &FD21,0:OUT &FD22,3:OUT &FD23,68
183 OUT &FD21,0:OUT &FD22,4:OUT &FD23,1
184 REM Write DNS: 192.168.68.54
185 OUT &FD21,0:OUT &FD22,&32:OUT &FD23,192
186 OUT &FD21,0:OUT &FD22,&33:OUT &FD23,168
187 OUT &FD21,0:OUT &FD22,&34:OUT &FD23,68
188 OUT &FD21,0:OUT &FD22,&35:OUT &FD23,54
189 REM Verify IP was written correctly
190 OUT &FD21,0:OUT &FD22,&F
191 A=INP(&FD23)
192 OUT &FD21,0:OUT &FD22,&10
193 B=INP(&FD23)
194 OUT &FD21,0:OUT &FD22,&11
195 C=INP(&FD23)
196 OUT &FD21,0:OUT &FD22,&12
197 D=INP(&FD23)
198 PRINT "Configured IP: ";A;".";B;".";C;".";D
199 PRINT "Gateway: 192.168.68.1"
200 PRINT "Subnet: 255.255.255.0"
201 PRINT "Network configured OK"
202 PRINT "Press any key to continue..."
203 CALL &BB18:REM Wait for keypress
204 PRINT
300 REM Load terminal binary
310 LOAD "EWENN4C.BIN",&7000
400 REM Install RSX
410 CALL &7000
500 REM Setup screen
510 MODE 2:BORDER 0:INK 0,0:INK 1,26
520 PRINT "Ewen-Term Communications program, v3.0 N4C installed."
530 PRINT "Network: 192.168.68.254 / DNS: 192.168.68.54"
540 PRINT
550 PRINT "Type |TERM to start terminal mode"
560 PRINT
600 REM Auto-start terminal (comment out if not wanted)
610 REM |TERM
\r\r